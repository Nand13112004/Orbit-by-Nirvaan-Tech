generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model User {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole
  active        Boolean  @default(true)
  managerId     String?
  manager       User?    @relation("Team", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamMembers   User[]   @relation("Team")
  assignedLeads Lead[]   @relation("LeadAssignee")
  createdLeads  Lead[]   @relation("LeadCreator")
  notes         LeadNote[]
  followUps     FollowUp[] @relation("FollowUpCreator")
  auditEvents   AuditLog[] @relation("AuditActor")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([managerId, role])
}

model Lead {
  id           String     @id @default(cuid()) @map("_id")
  name         String
  email        String?
  phone        String?
  company      String?
  other        String?
  status       LeadStatus @default(NEW)
  sourceId     String?
  source       LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assigneeId   String
  assignee     User       @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById  String
  createdBy    User       @relation("LeadCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes        LeadNote[]
  followUps    FollowUp[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([sourceId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([name])
}

model LeadNote {
  id        String   @id @default(cuid()) @map("_id")
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@index([leadId])
}

model FollowUp {
  id          String   @id @default(cuid()) @map("_id")
  dueAt       DateTime
  description String
  destination String?
  completed   Boolean  @default(false)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdById String
  createdBy   User     @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())

  @@index([dueAt, completed])
  @@index([completed, dueAt])
  @@index([leadId])
}

model LeadSource {
  id     String @id @default(cuid()) @map("_id")
  name   String @unique
  leads  Lead[]
}

model AppSetting {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model UserSession {
  id        String   @id @default(cuid()) @map("_id")
  sid       String   @unique
  userId    String?
  data      Json
  expiresAt DateTime
}
