# Copy this file to apps/api/.env. Keep real credentials out of Git and the frontend.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
# Optional comma-separated additional frontend origins (for example, a fixed preview domain).
APP_ORIGINS=
TRUST_PROXY_HOPS=0
# MongoDB Atlas application database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nirvaanos?retryWrites=true&w=majority
# Set only while copying records from the existing PostgreSQL database.
# Keep the PostgreSQL URI out of frontend variables and never print it.
POSTGRES_SOURCE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Initial Admin Account
INITIAL_ADMIN_NAME=Nand Delvadiya
INITIAL_ADMIN_EMAIL=admin@nirvaantech.in
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Initial Manager Account
INITIAL_MANAGER_NAME=Kruti Jasani
INITIAL_MANAGER_EMAIL=manager@nirvaantech.in
INITIAL_MANAGER_PASSWORD=CHANGE_ME_MANAGER_PASSWORD

# Initial Team Member Account
INITIAL_MEMBER_NAME=Nirvaan Team Member
INITIAL_MEMBER_EMAIL=member@nirvaantech.in
INITIAL_MEMBER_PASSWORD=CHANGE_ME_MEMBER_PASSWORD

# Optional Orbit Assistant. Keep this key in the API environment only.
OPENROUTER_API_KEY=
